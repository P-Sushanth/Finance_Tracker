# Keystore properties configuration for Android Release signing
# To generate a release keystore, run:
# keytool -genkey -v -keystore release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias finance_tracker_key
#
# Then copy this file to `android/key.properties` and fill in your passwords:
storePassword=your_keystore_password
keyPassword=your_key_password
keyAlias=finance_tracker_key
storeFile=release.jks
